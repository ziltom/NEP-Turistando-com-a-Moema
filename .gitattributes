# Padroniza o fim de linha dentro do repositorio como LF.
# Sem isso, arquivos criados no Linux e editados no Windows aparecem como
# "modificados" mesmo sem nenhuma mudanca de conteudo, e o git passa a
# recusar pull/rebase por "unstaged changes".
* text=auto eol=lf

# Binarios nao devem sofrer conversao nenhuma.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
